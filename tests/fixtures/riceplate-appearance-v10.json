{
  "schema_version": 10,
  "id": "styled-panel",
  "name": "Styled shared shell",
  "components": [
    {"id": "net", "role": "status", "binding": "network", "label": "Network"},
    {"id": "wifi", "role": "action", "binding": "wifi-toggle", "label": "Wi-Fi"}
  ],
  "panel": {
    "position": "top", "height": 48,
    "metrics": {"launcher_width": 120, "task_width": 168, "clock_width": 120},
    "layout": {
      "start": [{"type": "widget", "id": "launcher"}, {"type": "widget", "id": "tasks"}],
      "center": [{"type": "label", "text": "Styled Rice"}],
      "end": [{"type": "component", "ref": "wifi"}, {"type": "component", "ref": "net"}]
    }
  },
  "colors": {"background": "#10243a", "foreground": "#f5f8ff", "active": "#2e6d98"},
  "menu": {"title": "Style Preview", "presentation": "sidebar", "groups": [
    {"title": "Programs", "actions": ["applications", "terminal"]},
    {"title": "Session", "actions": ["lock", "logout"]}
  ]},
  "desktop": {"wallpaper": "aurora-day", "icons": [
    {"label": "Applications", "action": "applications", "x": 32, "y": 96}
  ]},
  "tokens": {"label_padding": 10, "task_radius": 8},
  "responsive": {"compact_max_width": 840, "compact_layout": {
    "start": [{"type": "widget", "id": "launcher"}],
    "center": [{"type": "widget", "id": "tasks"}],
    "end": [{"type": "component", "ref": "net"}]
  }},
  "composition": {
    "widgets": [{"id": "desk-net", "kind": "component", "ref": "net", "x": 32, "y": 430}],
    "window_region": {"x": 30, "y": 8, "width": 66, "height": 84},
    "compact_hide_widgets": ["desk-net"]
  },
  "appearance": {
    "font_scale": 2, "font_weight": "bold", "item_spacing": 6,
    "hover": "#336699", "focus": "#ffffff", "disabled": "#7a7a7a"
  }
}

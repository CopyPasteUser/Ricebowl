{
  "schema_version": 9,
  "id": "shared-components",
  "name": "Shared shell capabilities",
  "components": [
    {"id": "net-status", "role": "status", "binding": "network", "label": "Network"},
    {"id": "wifi-switch", "role": "action", "binding": "wifi-toggle", "label": "Wi-Fi"},
    {"id": "audio-status", "role": "status", "binding": "audio", "label": "Audio"}
  ],
  "panel": {
    "position": "top", "height": 44,
    "metrics": {"launcher_width": 104, "task_width": 164, "clock_width": 96},
    "layout": {
      "start": [
        {"type": "widget", "id": "launcher"},
        {"type": "widget", "id": "tasks"},
        {"type": "component", "ref": "wifi-switch"}
      ],
      "center": [{"type": "label", "text": "Shared Components"}],
      "end": [
        {"type": "component", "ref": "net-status"},
        {"type": "widget", "id": "clock"}
      ]
    }
  },
  "colors": {"background": "#203c59", "foreground": "#f3f7fa", "active": "#4179aa"},
  "menu": {"title": "Shared", "presentation": "sidebar", "groups": [
    {"title": "Programs", "actions": ["applications", "terminal"]},
    {"title": "Session", "actions": ["lock", "logout"]}
  ]},
  "desktop": {"wallpaper": "luna-hills", "icons": [
    {"label": "Applications", "action": "applications", "x": 32, "y": 96},
    {"label": "Terminal", "action": "terminal", "x": 32, "y": 208}
  ]},
  "tokens": {"label_padding": 8, "task_radius": 6},
  "responsive": {"compact_max_width": 840, "compact_layout": {
    "start": [{"type": "widget", "id": "launcher"}],
    "center": [{"type": "widget", "id": "tasks"}],
    "end": [{"type": "component", "ref": "net-status"}]
  }},
  "composition": {
    "widgets": [
      {"id": "desk-clock", "kind": "clock", "x": 32, "y": 320},
      {"id": "desk-net", "kind": "component", "ref": "net-status", "x": 32, "y": 432},
      {"id": "desk-audio", "kind": "component", "ref": "audio-status", "x": 32, "y": 544},
      {"id": "desk-title", "kind": "text", "text": "Welcome to RiceBowl", "x": 32, "y": 656}
    ],
    "window_region": {"x": 30, "y": 8, "width": 66, "height": 84},
    "compact_hide_widgets": ["desk-net", "desk-audio"]
  }
}

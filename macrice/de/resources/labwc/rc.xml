<?xml version="1.0" encoding="UTF-8"?>
<!-- Isolated preview configuration: never overrides ~/.config/labwc. -->
<labwc_config>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="ricebowl de lock" />
    </keybind>
    <!-- Only this opt-in labwc session owns these keys; XFCE stays unchanged. -->
    <keybind key="Print">
      <action name="Execute" command="ricebowl de shot --clipboard" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="ricebowl de shot --shot-mode region --clipboard" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl --class=backlight set 5%+" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl --class=backlight set 5%-" />
    </keybind>
  </keyboard>
</labwc_config>
